---
// Doctors: the six names from the clinic's home page (B-F020) as an index, beside a rail of the clinic's
// portraits. Specialisation and schedule per doctor come from C-108; the photo-to-name match is unknown, so portraits
// carry no visible names; alt text names a person only where the match is certain.
import { Picture } from "astro:assets";
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { doctors } from "../data/clinic";
import d1 from "../assets/img/doctor-1.jpg";
import d2 from "../assets/img/doctor-2.jpg";
import d3 from "../assets/img/doctor-3.jpg";
import d4 from "../assets/img/doctor-4.jpg";
import d5 from "../assets/img/doctor-5.jpg";
import d6 from "../assets/img/doctor-6.jpg";

const portraits = [
  { src: d2, alt: "Лікарка клініки Mediostar", pos: "50% 20%" },
  { src: d6, alt: "Святослав Синюк, лікар клініки Mediostar", pos: "50% 22%" },
  { src: d1, alt: "Лікарка клініки Mediostar", pos: "50% 22%" },
  { src: d3, alt: "Лікарка клініки Mediostar", pos: "50% 18%" },
  { src: d4, alt: "Лікарка клініки Mediostar", pos: "50% 18%" },
  { src: d5, alt: "Лікарка клініки Mediostar", pos: "50% 20%" },
];
---
<Section id="likari" class="doctors" rec="WEB-R005,S-R013">
  <div class="container doctors__grid">
    <div class="doctors__head">
      <h2 class="doctors__title">Шість лікарів, які ведуть прийом</h2>
      <ul class="doctors__names">
        {doctors.map((d) => (
          <li class="doctors__item">
            <h3 class="doctors__h"><FutureLink note="Розділ у розробці" class="doctors__name">{d.name}</FutureLink></h3>
            <p class="doctors__role">{d.role}</p>
            <p class="doctors__hours tnum">{d.hours}</p>
          </li>
        ))}
      </ul>
      <p class="doctors__note">Прийом у Львові, графік згідно з записом.</p>
      <a class="text-link doctors__book" href="#kliniky" data-open-sheet>Записатися до лікаря</a>
    </div>

    <div class="doctors__rail" data-rail>
      <ul class="rail" data-rail-track tabindex="0" aria-label="Фото лікарів клініки, прокрутка вбік">
        {portraits.map((p) => (
          <li class="portrait">
            <Picture
              src={p.src}
              formats={["avif", "webp"]}
              widths={[320, 480, 640]}
              sizes="(min-width: 60rem) 18rem, 70vw"
              alt={p.alt}
              loading="lazy"
              class="portrait__img"
              style={`object-position: ${p.pos}`}
            />
          </li>
        ))}
      </ul>
      <div class="rail-controls">
        <button type="button" class="icon-btn rail-btn" data-rail-prev aria-label="Попередні фото">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M15 5 8 12l7 7"/></svg>
        </button>
        <button type="button" class="icon-btn rail-btn" data-rail-next aria-label="Наступні фото">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="m9 5 7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</Section>
