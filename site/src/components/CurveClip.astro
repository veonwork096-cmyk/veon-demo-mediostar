---
<svg class="curve-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <clipPath id="curve-s" clipPathUnits="objectBoundingBox">
    <path d="M0,0 H1 V0.74 C0.9013,0.7949 0.7,0.8587 0.7,0.9624 C0.7,0.9761 0.7026,0.9886 0.7077,1 H0 Z"/>
  </clipPath>
  <clipPath id="curve-s-small" clipPathUnits="objectBoundingBox">
    <path d="M0,0 H1 V0.84 C0.9342,0.8738 0.8,0.913 0.8,0.9768 C0.8,0.9853 0.8017,0.993 0.8051,1 H0 Z"/>
  </clipPath>
</svg>
