---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { cities } from "../data/clinic";
---
<Base lang="uk" title="Сторінку не знайдено — Mediostar" description="Такої сторінки немає. Поверніться на головну або зателефонуйте в клініку.">
  <header slot="header" class="site-header">
    <div class="container site-header__row">
      <a class="brand" href="/" aria-label="Mediostar, на головну"><Logo class="brand__mark" /></a>
    </div>
  </header>
  <section class="not-found">
    <div class="container not-found__inner">
      <h1 class="not-found__title">Такої сторінки немає</h1>
      <p class="not-found__text">Поверніться на <a class="text-link" href="/">головну</a> або зателефонуйте в клініку свого міста.</p>
      <ul class="consult__calls not-found__calls">
        {cities.map((c) => (
          <li>
            <a class="call-row" href={c.phones[0].href}>
              <span class="call-row__city">{c.name}</span>
              <span class="call-row__phone tnum">{c.phones[0].display}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .not-found { padding-block: var(--space-3xl) var(--space-4xl); }
  .not-found__inner { display: grid; gap: var(--space-lg); max-width: 40rem; margin-inline: auto; }
  .not-found__title { font-size: var(--text-3xl); line-height: 1.08; }
  .not-found__text { font-size: var(--text-lg); }
  .not-found__calls { margin-top: var(--space-md); }
</style>
