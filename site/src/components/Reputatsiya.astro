---
// Ratings with their source and the month they were checked (B-F006, B-F008). No quotes: none were supplied.
import Section from "./Section.astro";
---
<Section id="reputatsiya" class="ratings" rec="WEB-R007,MA-R009,S-R013">
  <div class="container">
    <h2 class="visually-hidden">Рейтинги клініки</h2>
    <ul class="ratings__list">
      <li class="ratings__item">
        <span class="ratings__fig tnum">4,6</span>
        <span class="ratings__src">рейтинг на Top20.ua, 227 відгуків про клініку у Львові</span>
      </li>
      <li class="ratings__item">
        <span class="ratings__fig tnum">12 з 12</span>
        <span class="ratings__src">оцінка на 032.ua за 19 оцінками, Львів</span>
      </li>
      <li class="ratings__item ratings__item--note">
        <span class="ratings__src">Дані майданчиків перевірено в листопаді 2026 року.</span>
      </li>
    </ul>
  </div>
</Section>
