---
// One-line header: logo → #top, anchors to homepage blocks, future pages as FutureLink,
// city switch (changes the header phone, works without JS via :has), «Записатися» with both cities.
import Logo from "./Logo.astro";
import FutureLink from "./FutureLink.astro";
import { cities } from "../data/clinic";

const nav = [
  { label: "Напрями", href: "#napryamy" },
  { label: "Лікарі", href: "#likari" },
  { label: "Обладнання", href: "#pidkhid" },
  { label: "Ціни" },
  { label: "Акції" },
  { label: "Клініки", href: "#kliniky" },
];
const note = "Розділ у розробці";
---
<header class="site-header" data-header data-rec="WEB-R002">
  <div class="container site-header__row">
    <a class="brand" href="#top" aria-label="Mediostar, на початок сторінки"><Logo class="brand__mark" /></a>

    <nav class="nav" aria-label="Головне меню">
      <ul class="nav__list">
        {nav.map((item) => (
          <li>{item.href ? <a class="nav__link" href={item.href}>{item.label}</a> : <FutureLink note={note} class="nav__link">{item.label}</FutureLink>}</li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <fieldset class="city-switch">
        <legend class="visually-hidden">Ваше місто</legend>
        {cities.map((c, i) => (
          <>
            <input type="radio" name="city" id={`city-${c.id}`} value={c.id} checked={i === 0} data-city-radio />
            <label for={`city-${c.id}`}>{c.name}</label>
          </>
        ))}
      </fieldset>

      <div class="header-phone">
        {cities.map((c) => (
          <a class="header-phone__link tnum" href={c.phones[0].href} data-phone-for={c.id}>
            <span class="visually-hidden">{c.name}: </span>{c.phones[0].display}
          </a>
        ))}
      </div>

      <details class="book" data-dismiss>
        <summary class="btn btn--primary">Записатися</summary>
        <div class="book__panel" role="group" aria-label="Запис у клініку">
          {cities.map((c) => (
            <div class="book__city">
              <p class="book__name">{c.name}</p>
              <a class="book__phone tnum" href={c.phones[0].href}>{c.phones[0].display}</a>
              <p class="book__msg"><a href={c.viber}>Viber</a><a href={c.telegram} rel="noopener">Telegram</a></p>
            </div>
          ))}
          <a class="book__all" href="#kliniky">Адреси та всі номери</a>
        </div>
      </details>

      <a class="icon-btn call-btn" href="#kliniky" data-open-sheet aria-label="Зателефонувати в клініку">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M6.6 3.5h3l1.5 4.2-2 1.4a12 12 0 0 0 5.8 5.8l1.4-2 4.2 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"/></svg>
      </a>

      <details class="menu" data-dismiss>
        <summary class="icon-btn" aria-label="Меню">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path stroke="currentColor" stroke-width="1.6" d="M3 7h18M3 12h18M3 17h18"/></svg>
        </summary>
        <div class="menu__panel">
          <ul class="menu__list">
            {nav.map((item) => (
              <li>{item.href ? <a class="menu__link" href={item.href}>{item.label}</a> : <FutureLink note={note} class="menu__link">{item.label}</FutureLink>}</li>
            ))}
          </ul>
          <ul class="menu__langs" aria-label="Мова сайту">
            <li><span class="menu__lang-current" aria-current="true">Українська</span></li>
            <li><FutureLink note={note} class="menu__lang">English</FutureLink></li>
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>
